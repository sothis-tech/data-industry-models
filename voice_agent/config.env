# ==========================================
# Configuración del Entorno - Voice Agent
# ==========================================

# --- Logging ---
# Niveles: DEBUG (detallado), INFO (estándar), WARNING (solo errores)
LOG_LEVEL=DEBUG

# --- Detección de Voz (VAD) ---
# Sensibilidad del micrófono (RMS). Subir si hay mucho ruido, bajar si no detecta voz suave.
MIN_RMS=0.003
# Duración mínima de habla para considerarlo una frase válida (segundos).
# 0.5 mejora comandos cortos ("si", "no") sin abrir demasiado el filtro.
MIN_VOICE_SEC=0.2
# Tiempo de silencio para considerar fin de frase (ms)
SILENCE_WAIT_MS=2000
# Agresividad del VAD de WebRTC (0=menos agresivo, 3=más agresivo para filtrar ruido)
VAD_MODE=3

# --- Wake Word (Palabra de Activación) ---
WAKE_WORD=marvin
# Variantes fonéticas aceptadas (separadas por coma)
WAKE_WORD_ALIASES=marby,martin,marlin,mar vi,marlene,marpin,marguerite,marín,mari,martín,marvín,marwin
# Timeout: Tiempo que el agente espera un comando tras activarse antes de volver a dormir (segundos)
ACTIVE_TIMEOUT_SEC=8.0

# --- Modelo LLM (Ollama) ---
LLM_MODEL=phi3:mini
# Tokens máximos a generar (Menos = más rápido). 60 es aprox. 1-2 frases cortas.
LLM_NUM_PREDICT=60
# Creatividad (0.0 = determinista, 1.0 = creativo)
LLM_TEMPERATURE=0.7

# --- Whisper (ASR) ---
# Idioma forzado para mejorar precisión (ej: 'es' para español, 'en' para inglés)
WHISPER_LANG=es

# --- Agente externo (mock local o agente real) ---
# Con backend en Docker y mock en el host: host.docker.internal para alcanzar tu PC
# Agente industrial (LLM) en el host — puerto 8082 según docker-compose del proyecto agente_control_data_space
AGENT_API_URL=http://host.docker.internal:8082/api/chat
# Timeout total de la petición al agente (segundos). Súbelo si el LLM tarda en construir gráficos.
AGENT_TIMEOUT_TOTAL_SEC=90
# Timeout máximo para establecer conexión TCP con el agente (segundos).
AGENT_TIMEOUT_CONNECT_SEC=10

# --- Modo direct (gafas): comportamiento ante ruido/sin voz valida ---
# spoken: siempre responde "No se detecto voz."
# silent: nunca habla, solo envia ignored_noise
# hybrid: ignora ruido al inicio y solo habla tras varios descartes o tiempo acumulado
DIRECT_NO_VOICE_MODE=silent
# En modo hybrid: cuantos descartes consecutivos se permiten en silencio
DIRECT_IGNORED_NOISE_MAX_COUNT=2
# En modo hybrid: maximo tiempo acumulado (s) de descartes antes de hablar
DIRECT_IGNORED_NOISE_MAX_WINDOW_SEC=10
