# Copiar a .env junto a docker-compose.yml y ajustar.

# Puerto en el host donde publicar el contenedor (por defecto 8844; el contenedor escucha en 8844)
HOST_PORT=8844

# Orígenes permitidos para CORS (coma separados). En VM con IP o dominio:
# CORS_ORIGINS=http://10.0.0.5:8844,https://modelador.ejemplo.com
CORS_ORIGINS=*

LOG_FORMAT=json
LOG_LEVEL=INFO

# ── Chatbot / Agente de escucha activa (AEA) ──────────────────────
# Vacío → ws(s)://<misma página>/api/aea/ws (proxy; un solo puerto reenviado). Directo al AEA: ws://host:8000/ws/audio
AEA_WS_URL=
# Interno (contenedor modelador → host donde escucha el voice-agent):
# AEA_WS_BACKEND_URL=ws://dataspace-voice-agent:8004/ws/audio

# URL del agente LLM para chat por texto (rutas internas, sin exponer al navegador)
CHAT_LLM_URL=
# Opcional: POST /api/connect del agente (por defecto mismo host que CHAT_LLM_URL + /api/connect)
# CHAT_LLM_CONNECT_URL=http://llm-agent:8080/api/connect
# API key para el LLM si exige autenticación Bearer
CHAT_LLM_API_KEY=
# Timeout en segundos para llamadas al LLM (default 30)
CHAT_LLM_TIMEOUT_SECONDS=30
# Identificadores de contexto por defecto (pueden sobreescribirse desde el front)
CHAT_CLIENT_ID=modelador
CHAT_LEVEL_ID=default_level

# ── RAG / ChromaDB externo ────────────────────────────────────────────
# URL del endpoint de subida del servicio RAG (dejar vacío para deshabilitar el widget)
RAG_URL=
# URL base del servicio RAG (proxies /api/rag/*); si vacío se deriva de RAG_URL
# RAG_BASE_URL=http://rag-manager:8300
# API key del servicio RAG si requiere autenticación Bearer
RAG_API_KEY=
# Tamaño máximo de documento en MB (default 20)
RAG_MAX_MB=20
# Fallback solo para el proxy del modelador cuando una petición no envía tenant (p. ej. scripts).
# El panel RAG de la UI usa siempre el Fiware-Service del broker activo, no este valor.
RAG_CHROMA_DB=default


# ── Orion / Kong / Keycloak ─────────────────────────────────────────
ORION_AUTH_REQUIRED=true
ORION_KEYCLOAK_REALM=fiware
ORION_KEYCLOAK_CLIENT_ID=orion-client
ORION_KEYCLOAK_CLIENT_SECRET=RELLENAR_CON_EL_SECRET_DE_KEYCLOAK
ORION_AUTH_TIMEOUT_SECONDS=10
# Normalmente NO tocar:
# Derivado de la URL base Kong que pongas en la UI:
#   http://localhost:8010/realms/fiware/protocol/openid-connect/token
# ORION_KEYCLOAK_TOKEN_URL=
# ORION_KEYCLOAK_LOGOUT_URL=
# Solo para pruebas contra Orion directo sin Kong:
ORION_SEND_FIWARE_SERVICE=false