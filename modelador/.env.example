# Puerto en el host donde publicar el modelador
HOST_PORT=8844
CORS_ORIGINS=*
LOG_FORMAT=json
LOG_LEVEL=INFO
# ── Chatbot / Voz (AEA) ──────────────────────────────────────────────────────
# AEA_WS_URL vacío → el front usa ws(s)://<misma página>/api/aea/ws (un solo puerto reenviado, p. ej. SSH -L 8844).
# Solo rellena AEA_WS_URL si el navegador debe conectar directo al voice-agent (puerto 8000).
AEA_WS_URL=
# URL del WebSocket del voice-agent vista desde DENTRO del contenedor del modelador:
AEA_WS_BACKEND_URL=ws://dataspace-voice-agent:8004/ws/audio

# ── Chat texto (LLM) ─────────────────────────────────────────────────────────
# industrial-mcp-api, expuesto en host:8082, endpoint POST /api/chat
CHAT_LLM_URL=http://172.17.0.1:8082/api/chat
CHAT_LLM_API_KEY=
CHAT_LLM_TIMEOUT_SECONDS=60
CHAT_CLIENT_ID=modelador
CHAT_LEVEL_ID=default_level
# ── RAG / ChromaDB ────────────────────────────────────────────────────────────
# rag-manager backend no está corriendo aún (ver instrucciones abajo)
# Cuando esté arriba en :8300, descomenta y ajusta:
# RAG_URL=http://172.17.0.1:8300/tenants/default_tenant/upload
RAG_URL=http://rag-manager:8300/upload
RAG_BASE_URL=http://rag-manager:8300
RAG_API_KEY=
RAG_MAX_MB=20
# Fallback del proxy /api/rag/* si la petición no lleva tenant (scripts, integraciones).
# El panel RAG en la UI usa siempre el Fiware-Service del broker activo, no esta variable.
RAG_CHROMA_DB=default_tenant

# ── Orion / Kong / Keycloak ─────────────────────────────────────────
ORION_AUTH_REQUIRED=true
ORION_KEYCLOAK_REALM=
ORION_KEYCLOAK_CLIENT_ID=
ORION_KEYCLOAK_CLIENT_SECRET=
ORION_AUTH_TIMEOUT_SECONDS=10
# Normalmente NO tocar:
# Derivado de la URL base Kong que pongas en la UI:
#   http://localhost:8010/realms/fiware/protocol/openid-connect/token
# ORION_KEYCLOAK_TOKEN_URL=
# ORION_KEYCLOAK_LOGOUT_URL=
# Solo para pruebas contra Orion directo sin Kong:
ORION_SEND_FIWARE_SERVICE=false