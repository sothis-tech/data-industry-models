FROM kong:3.9
USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl git luarocks \
    && rm -rf /var/lib/apt/lists/*
RUN luarocks install lua-resty-jwt
COPY kong/plugins/tenant-role /usr/local/share/lua/5.1/kong/plugins/tenant-role
RUN chown -R kong:kong /usr/local/share/lua/5.1/kong/plugins/tenant-role
ENV KONG_PLUGINS="bundled,tenant-role"
USER kong