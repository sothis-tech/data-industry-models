{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/IndustrialOven/schemas/ManufacturingMachine.json",
  "title": "ManufacturingMachine (Industrial Oven – extendido)",
  "description": "Extiende el modelo oficial añadiendo hasPart. No modifica atributos existentes.",
  "type": "object",
  "allOf": [
    {
      "$ref": "https://smart-data-models.github.io/dataModel.ManufacturingMachine/ManufacturingMachine/schema.json"
    },
    {
      "properties": {
        "hasPart": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[\\w\\-\\.\\{\\}\\$\\+\\*\\[\\]`|~^@!,:\\\\]+$"
              },
              {
                "type": "string",
                "format": "uri"
              }
            ]
          },
          "description": "Extension. Relationship. Lista de URIs de entidades Device (componentes y sondas) que forman parte de la máquina. schema.org/hasPart"
        }
      }
    }
  ]
}
