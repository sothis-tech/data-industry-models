# rag-manager — configuración (sin secretos)

# ChromaDB. En el despliegue manual era localhost:8200.
# En el stack docker-compose rag-manager corre en la red red_dataspace:
# apunta CHROMA_HOST al nombre del servicio (chromadb) y CHROMA_PORT a su
# puerto INTERNO de contenedor, no al publicado en el host.
CHROMA_HOST=localhost
CHROMA_PORT=8200
CHROMA_COLLECTION=manuales_tecnicos

# Rutas dentro del contenedor (montadas como los volúmenes rag_docs / hf_cache)
DOCS_PATH=/data/rag_docs
HF_HOME=/data/hf_cache

# Puerto del servicio rag-manager
PORT=8300
